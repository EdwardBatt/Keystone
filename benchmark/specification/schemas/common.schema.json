{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keystone:bench:common:1",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "nonblank": { "type": "string", "pattern": "\\S" },
    "file": { "type": "string", "minLength": 1, "maxLength": 512 },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "count": { "type": "integer", "minimum": 0 },
    "seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+,-]{0,255}$" },
    "nullableIdentifier": { "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }] },
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "$ref": "#/$defs/nullableCount" },
        "output_tokens": { "$ref": "#/$defs/nullableCount" },
        "turns": { "$ref": "#/$defs/nullableCount" },
        "tool_calls": { "$ref": "#/$defs/nullableCount" },
        "tool": { "$ref": "#/$defs/nullableIdentifier" },
        "model": { "$ref": "#/$defs/nullableIdentifier" },
        "unrecognized_identity": { "const": true }
      }
    },
    "trusted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "models": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,255}$" } }
      }
    },
    "usage2": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_tokens": { "$ref": "#/$defs/nullableCount" },
        "output_tokens": { "$ref": "#/$defs/nullableCount" },
        "turns": { "$ref": "#/$defs/nullableCount" },
        "tool_calls": { "$ref": "#/$defs/nullableCount" },
        "tool": { "$ref": "#/$defs/nullableIdentifier" },
        "model": { "$ref": "#/$defs/nullableIdentifier" },
        "unrecognized_identity": { "const": true },
        "model_mismatch": { "const": true }
      }
    },
    "toolVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._:/@+()-]{0,255}$" },
    "bundleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path"],
      "properties": {
        "repository": { "enum": ["subject", "benchmark", "keystone"] },
        "path": { "$ref": "#/$defs/file" }
      }
    },
    "nullableCount": { "type": ["integer", "null"], "minimum": 0 },
    "nullableNumber": { "type": ["number", "null"] }
  }
}
