{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keystone:bench:packet-release:1",
  "title": "keystone-bench owner release of an inspected judging packet (manual gate)",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "plan", "packet_hash", "inspection_log_hash", "reviewed_by", "date", "statement"],
  "properties": {
    "kind": { "const": "keystone-bench-packet-release" },
    "schema_version": { "const": 1 },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "hash"],
      "properties": {
        "id": { "$ref": "urn:keystone:bench:common:1#/$defs/id" },
        "hash": { "$ref": "urn:keystone:bench:common:1#/$defs/hash" }
      }
    },
    "packet_hash": { "$ref": "urn:keystone:bench:common:1#/$defs/hash" },
    "inspection_log_hash": { "$ref": "urn:keystone:bench:common:1#/$defs/hash" },
    "reviewed_by": { "const": "owner" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "statement": { "$ref": "urn:keystone:bench:common:1#/$defs/nonblank" }
  }
}
