{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keystone:bench:inspection-terms:1",
  "title": "keystone-bench judging-packet inspection terms",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "id", "terms"],
  "properties": {
    "kind": { "const": "keystone-bench-inspection-terms" },
    "schema_version": { "const": 1 },
    "id": { "$ref": "urn:keystone:bench:common:1#/$defs/id" },
    "description": { "type": "string" },
    "terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "$ref": "urn:keystone:bench:common:1#/$defs/id" },
          "literal": { "type": "string", "minLength": 2, "maxLength": 256 },
          "pattern": { "type": "string", "minLength": 2, "maxLength": 256 }
        }
      }
    }
  }
}
