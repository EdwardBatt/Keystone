{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keystone:bench:manual-record:1",
  "title": "keystone-bench manual run input",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "sessions", "fix_sessions"],
  "properties": {
    "kind": { "const": "keystone-bench-manual-record" },
    "schema_version": { "const": 1 },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "duration_seconds", "usage"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$" },
          "status": { "enum": ["ok", "failed"] },
          "duration_seconds": { "type": ["number", "null"], "minimum": 0 },
          "usage": { "oneOf": [{ "$ref": "urn:keystone:bench:common:1#/$defs/usage" }, { "type": "null" }] }
        }
      }
    },
    "fix_sessions": { "type": "integer", "minimum": 0, "maximum": 20 }
  }
}
