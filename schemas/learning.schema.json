{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:keystone:schema:common:1#/$defs/metadata"
    }
  ],
  "required": [
    "context_type",
    "schema_version",
    "id",
    "status"
  ],
  "properties": {
    "context_type": {
      "const": "learning"
    },
    "schema_version": {
      "const": 1
    },
    "superseded_by": {
      "$ref": "urn:keystone:schema:common:1#/$defs/stringList"
    },
    "retirement": {
      "type": "object",
      "required": [
        "task",
        "reason"
      ],
      "properties": {
        "task": {
          "$ref": "urn:keystone:schema:common:1#/$defs/nonemptyString"
        },
        "reason": {
          "$ref": "urn:keystone:schema:common:1#/$defs/nonblankString"
        },
        "previous_status": {
          "$ref": "urn:keystone:schema:common:1#/$defs/nonblankString"
        }
      },
      "additionalProperties": false
    },
    "id": {
      "$ref": "urn:keystone:schema:common:1#/$defs/metadata/properties/id"
    },
    "status": {
      "$ref": "urn:keystone:schema:common:1#/$defs/metadata/properties/status"
    }
  },
  "additionalProperties": true
}
